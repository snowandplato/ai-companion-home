# ============================================================================
# AI Gateway Service - environment template
# Copy this file to .env, then fill real values on the server.
# Do not commit or upload real API keys in this template.
# ============================================================================

# ========== Main model ==========
# Reading and notes use this server-side configuration, independently of chat UI.
# These modules currently require an OpenAI-compatible /chat/completions API.
MAIN_API_PROVIDER=zenmux
MAIN_BASE_URL=https://zenmux.ai/api/v1
MAIN_API_KEY=
MAIN_MODEL=your-chat-model-id

# ========== Summary / small model ==========
# Used by daily summaries, short-term snapshot, search-query compression,
# and some memory judging tasks.
SUMMARY_API_PROVIDER=zenmux
SUMMARY_BASE_URL=https://zenmux.ai/api/v1
SUMMARY_API_KEY=
# Use a model ID offered by your chosen provider, including its prefix if needed.
SUMMARY_MODEL=your-summary-model-id
MEMORY_JUDGE_MODEL=your-summary-model-id

# ========== Summary trigger ==========
SUMMARY_TRIGGER_ROUNDS=5
CONTEXT_WINDOW_ROUNDS=30
RECENT_CONTEXT_ROUNDS=10

# ========== Memory ==========
MEMORY_TOP_N=4
MEMORY_RANDOM_N=1
MEMORY_INJECTION_MODE=v2
MEMORY_WRITE_MODE=v2
MEMORY_V2_THREAD_TOP_N=2
MEMORY_V2_EVENT_TOP_N=5
MEMORY_V2_EMBEDDING_EVENT_MIN=2
MEMORY_V2_EMBEDDING_EVENT_MAX=2
MEMORY_V2_SIBLING_N=1
MEMORY_V2_SIBLING_TOTAL_N=3
MEMORY_V2_RANDOM_RESURFACE_MAX=1
MEMORY_V2_RANDOM_RESURFACE_CASUAL_RATE=0.25
MEMORY_V2_RANDOM_RESURFACE_NORMAL_RATE=0.15
MEMORY_V2_RANDOM_RESURFACE_LOW_RATE=0.03
SHORT_TERM_MEMORY_DAYS=15
MAV_NOTES_LIMIT=10

# ========== Lan portrait ==========
# Off by default. Review the portrait-update behavior before enabling it.
PORTRAIT_UPDATES_ENABLED=false
# Required only when opening or editing portrait content in Admin.
PORTRAIT_ADMIN_PASSWORD=
# Anthropic native prompt cache: off | 5m | 1h. Does not affect ZenMux/OpenAI paths.
PROMPT_CACHE_TTL=off

# ========== Embedding ==========
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_EVENT_TOP_N=8
EMBEDDING_THREAD_TOP_N=4
EMBEDDING_MIN_SCORE=0.45

# ========== Vision model ==========
# Used as the image middle layer for chat images and notes OCR/description.
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=
VL_MODEL=qwen3-vl-plus

# ========== Web search ==========
TAVILY_API_KEY=

# ========== Database / files ==========
DATA_DIR=./data
# Optional individual overrides (otherwise files live under DATA_DIR):
# DATABASE_PATH=/path/to/your/data/memory.db
# NOTE_IMAGE_DIR=/path/to/your/data/note_images
# CHAT_IMAGE_DIR=/path/to/your/data/chat_images
# ART_IMAGE_DIR=/path/to/your/data/art_images
# EPUB_DIR=/path/to/your/data/epubs
ART_IMAGE_BASE_URL=https://api.openai.com
ART_IMAGE_API_KEY=
ART_IMAGE_MODEL=gpt-image-2
ART_REVIEW_MODEL=claude-sonnet-4-6
ART_DRAFT_COUNT=3
ART_MAX_RETRIES=1

# ========== Service ==========
# Bind locally by default. Put a protected reverse proxy in front for remote access.
API_HOST=127.0.0.1
API_PORT=8000
# Add your actual frontend origin if it is hosted on a different domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
LOG_LEVEL=INFO

# ========== Provider backends used by the router ==========
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=

ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_API_KEY=
